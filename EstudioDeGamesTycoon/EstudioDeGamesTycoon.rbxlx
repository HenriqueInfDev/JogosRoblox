		end
	end)
end

-- animação do ovo chocando
local hatchFrame = panel(UDim2.fromOffset(380, 230), UDim2.fromScale(0.5, 0.45), Vector2.new(0.5, 0.5), Color3.fromRGB(255, 215, 0))
hatchFrame.Visible = false
