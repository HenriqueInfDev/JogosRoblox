              <token name="BottomSurface">0</token>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Lighting" referent="RBX903">
    <Properties>
      <string name="Name">Lighting</string>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="RBX904">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX905">
      <Properties>
        <string name="Name">TycoonConfig</string>
        <ProtectedString name="Source"><![CDATA[-- ============================================================
--  ESTÚDIO DE GAMES TYCOON - Configurações
--  Altere preços, valores e IDs de gamepass aqui.
-- ============================================================
local Config = {}

-- IDs dos Gamepasses (crie no site do Roblox e cole o número aqui; 0 = desativado)
Config.GAMEPASS_2X_ID = 0          -- "Dinheiro em Dobro"
Config.GAMEPASS_AUTOCOLLECT_ID = 0 -- "Coleta Automática"

-- Produtos de desenvolvedor (pacotes de dinheiro, podem ser comprados várias vezes; 0 = desativado)
-- O valor é multiplicado por (1 + rebirths), para continuar útil no fim do jogo.
Config.PRODUCTS = {
	{ Id = 0, Name = "Pacote Pequeno", Amount = 5000 },
	{ Id = 0, Name = "Pacote Médio",   Amount = 50000 },
	{ Id = 0, Name = "Pacote Grande",  Amount = 500000 },
}

Config.DATASTORE_NAME = "EstudioTycoon_v1"
Config.DROP_INTERVAL = 2      -- segundos entre cada cartucho produzido
Config.CONVEYOR_SPEED = 9     -- velocidade da esteira
Config.REBIRTH_BONUS = 0.5    -- +50% de renda por rebirth
Config.START_CASH = 0
Config.DAILY_BASE = 500        -- recompensa diária = DAILY_BASE x dia da sequência (até 7) x (1 + rebirths)
Config.OFFLINE_MAX_HOURS = 8   -- máximo de horas de lucro offline
Config.OFFLINE_RATE = 0.5      -- o estúdio rende 50% enquanto o jogador está fora
Config.BASE_ITEMS = { "mesa1" } -- itens que todo estúdio já começa com

-- Tipos:
--  Dropper    = funcionário que produz jogos (cartuchos). Value = valor de cada cartucho
--  Multiplier = multiplica todo o dinheiro ganho (Mult)
--  Speed      = acelera a produção (SpeedMult < 1 = mais rápido)
--  Decor      = decoração
--  Expansion  = libera a segunda linha de produção
--  Trophy     = libera o Rebirth
Config.Items = {
	{ Id = "mesa1",       Name = "Mesa do Fundador",          Price = 0,      Type = "Dropper", Value = 5 },
	{ Id = "dev2",        Name = "Estagiário",                Price = 60,     Requires = "mesa1",      Type = "Dropper", Value = 10 },
	{ Id = "paredes",     Name = "Paredes do Escritório",     Price = 150,    Requires = "dev2",       Type = "Decor" },
	{ Id = "dev3",        Name = "Programador Júnior",        Price = 250,    Requires = "dev2",       Type = "Dropper", Value = 20 },
	{ Id = "cafe",        Name = "Máquina de Café",           Price = 400,    Requires = "dev3",       Type = "Speed", SpeedMult = 0.75 },
	{ Id = "dev4",        Name = "Artista 2D",                Price = 700,    Requires = "dev3",       Type = "Dropper", Value = 40 },
	{ Id = "placa",       Name = "Letreiro do Estúdio",       Price = 900,    Requires = "paredes",    Type = "Decor" },
	{ Id = "dev5",        Name = "Game Designer",             Price = 1500,   Requires = "dev4",       Type = "Dropper", Value = 75 },
	{ Id = "marketing",   Name = "Outdoor de Marketing",      Price = 2500,   Requires = "dev5",       Type = "Multiplier", Mult = 1.5 },
	{ Id = "expansao",    Name = "Expansão do Estúdio",       Price = 4000,   Requires = "dev5",       Type = "Expansion" },
	{ Id = "dev6",        Name = "Animador 3D",               Price = 5500,   Requires = "expansao",   Type = "Dropper", Value = 125 },
	{ Id = "sofa",        Name = "Sala de Descanso",          Price = 6000,   Requires = "expansao",   Type = "Speed", SpeedMult = 0.9 },
	{ Id = "dev7",        Name = "Engenheiro de Áudio",       Price = 9000,   Requires = "dev6",       Type = "Dropper", Value = 200 },
	{ Id = "servidores",  Name = "Servidores na Nuvem",       Price = 14000,  Requires = "dev7",       Type = "Multiplier", Mult = 1.5 },
	{ Id = "dev8",        Name = "Programador Sênior",        Price = 18000,  Requires = "dev7",       Type = "Dropper", Value = 325 },
	{ Id = "dev9",        Name = "Diretor de Arte",           Price = 28000,  Requires = "dev8",       Type = "Dropper", Value = 500 },
	{ Id = "publicadora", Name = "Contrato com Publicadora Global", Price = 40000, Requires = "dev9",  Type = "Multiplier", Mult = 2 },
	{ Id = "dev10",       Name = "Lenda dos Games",           Price = 60000,  Requires = "dev9",       Type = "Dropper", Value = 800 },
	{ Id = "trofeu",      Name = "Troféu Game of the Year",   Price = 150000, Requires = "dev10",      Type = "Trophy" },
}

Config.ById = {}
for i, item in ipairs(Config.Items) do
	item.Order = i
	Config.ById[item.Id] = item
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx" }

function Config.Format(n: number): string
	n = math.floor(n or 0)
	local value = n
	local i = 1
	while math.abs(value) >= 1000 and i < #SUFFIXES do
		value = value / 1000
		i += 1
	end
	if i == 1 then
		return "$" .. tostring(n)
	end
	return string.format("$%.1f%s", value, SUFFIXES[i])
end

return Config
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX906">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX907">
      <Properties>
        <string name="Name">TycoonServer</string>
        <ProtectedString name="Source"><![CDATA[-- ============================================================
--  ESTÚDIO DE GAMES TYCOON - Servidor
--  Rift Studius
-- ============================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("TycoonConfig"))
local Format = Config.Format

-- ---------- Remotes ----------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage

local notifyEvent = Instance.new("RemoteEvent")
notifyEvent.Name = "Notify"
notifyEvent.Parent = remotes

local rebirthFunc = Instance.new("RemoteFunction")
rebirthFunc.Name = "Rebirth"
rebirthFunc.Parent = remotes

game:GetService("Lighting").ClockTime = 14.5

local dropsFolder = Instance.new("Folder")
dropsFolder.Name = "Cartuchos"
dropsFolder.Parent = workspace

-- ---------- DataStore ----------
local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Tycoon] DataStore indisponível (ative 'Enable Studio Access to API Services' para testar no Studio):", result)
	end
end

local playerData = {} -- [player] = { Cash, Rebirths, Owned, Bank, Loaded }
local playerPlot = {} -- [player] = state
local lastNotify = {} -- [player] = os.clock()

local function notify(player: Player, text: string, kind: string?)
	if kind == "erro" then
		local now = os.clock()
		if lastNotify[player] and now - lastNotify[player] < 1.5 then
			return
		end
		lastNotify[player] = now
	end
	notifyEvent:FireClient(player, text, kind or "info")
end

-- ---------- Helpers de UI no mundo ----------
local function makeBillboard(parent: Instance, offsetY: number, width: number, height: number, maxDist: number?)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(width, height)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.MaxDistance = maxDist or 80
	bb.LightInfluence = 0
	bb.Parent = parent
	return bb
end

local function makeLabel(parent: Instance, text: string, color: Color3, sizeY: number, posY: number, font: Enum.Font?)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, sizeY, 0)
	label.Position = UDim2.new(0, 0, posY, 0)
	label.Font = font or Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.Text = text
	label.Parent = parent
	return label
end

-- ---------- Dinheiro ----------
local function getCash(player: Player): number
	local ls = player:FindFirstChild("leaderstats")
	local cash = ls and ls:FindFirstChild("Dinheiro")
	return cash and cash.Value or 0
end

local function setCash(player: Player, amount: number)
	local ls = player:FindFirstChild("leaderstats")
	local cash = ls and ls:FindFirstChild("Dinheiro")
	if cash then
		cash.Value = math.max(0, math.floor(amount))
	end
end

local function addCash(player: Player, amount: number)
	setCash(player, getCash(player) + amount)
end

-- ---------- Estado dos estúdios ----------
local plots = {}

local function getMultiplier(state): number
	local m = 1
	for id in pairs(state.Owned) do
		local item = Config.ById[id]
		if item and item.Mult then
			m *= item.Mult
		end
	end
	local player = state.Owner
	if player then
		m *= 1 + Config.REBIRTH_BONUS * (player:GetAttribute("Rebirths") or 0)
		if player:GetAttribute("Has2x") then
			m *= 2
		end
	end
	return m
end

local function getSpeedFactor(state): number
	local f = 1
	for id in pairs(state.Owned) do
		local item = Config.ById[id]
		if item and item.SpeedMult then
			f *= item.SpeedMult
		end
	end
	return f
end

local function getIncomeRate(state): number
	local perDrop = 0
	for id in pairs(state.Owned) do
		local item = Config.ById[id]
		if item and item.Type == "Dropper" then
			perDrop += item.Value
		end
	end
	return perDrop / (Config.DROP_INTERVAL * getSpeedFactor(state)) * getMultiplier(state)
end

local function updateBank(state)
	if state.CollectLabel then
		state.CollectLabel.Text = Format(state.Bank)
	end
	if state.Owner then
		state.Owner:SetAttribute("Bank", state.Bank)
	end
end

local function updateDoor(state)
	if state.Owner then
		state.DoorTitle.Text = "Estúdio de " .. state.Owner.DisplayName
		state.DoorSub.Text = "🎮 Rift Studius"
		state.Door.Color = Color3.fromRGB(155, 89, 182)
	else
		state.DoorTitle.Text = "🎮 Estúdio Livre"
		state.DoorSub.Text = "Toque na porta para ser o dono!"
		state.Door.Color = Color3.fromRGB(0, 200, 255)
	end
	if state.SignLabel then
		state.SignLabel.Text = state.Owner and ("ESTÚDIO " .. string.upper(state.Owner.DisplayName)) or "ESTÚDIO"
	end
end

local function refreshButtons(state)
	local cash = state.Owner and getCash(state.Owner) or 0
	for id, btn in pairs(state.Buttons) do
		local item = Config.ById[id]
		local visible = state.Owner ~= nil
			and not state.Owned[id]
			and (item.Requires == nil or state.Owned[item.Requires] == true)
		if visible then
			btn.Parent = state.Model.Buttons
			local canBuy = cash >= item.Price
			btn.Color = canBuy and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
			local price = btn:FindFirstChild("PriceLabel", true)
			if price then
				price.TextColor3 = canBuy and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(255, 120, 110)
			end
		else
			btn.Parent = state.Storage
		end
	end
	if state.Owner then
		local goal = nil
		for id, btn in pairs(state.Buttons) do
			if btn.Parent == state.Model.Buttons then
				local item = Config.ById[id]
				if not goal or item.Price < goal.Price then
					goal = item
				end
			end
		end
		state.Owner:SetAttribute("NextGoal", goal and goal.Name or "")
		state.Owner:SetAttribute("NextPrice", goal and goal.Price or 0)
		state.Owner:SetAttribute("IncomeRate", math.floor(getIncomeRate(state)))
		state.Owner:SetAttribute("Multiplier", getMultiplier(state))
		state.Owner:SetAttribute("CanRebirth", state.Owned["trofeu"] == true)
	end
end

local function setConveyorVelocity(model: Instance)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "Esteira" then
			d.AssemblyLinearVelocity = -d.CFrame.RightVector * Config.CONVEYOR_SPEED
		end
	end
end

local function clearDrops(state)
	for _, drop in ipairs(dropsFolder:GetChildren()) do
		if drop:GetAttribute("Plot") == state.Model.Name then
			drop:Destroy()
		end
	end
end

local function ownItem(state, id: string)
	state.Owned[id] = true
	local model = state.ItemModels[id]
	if model then
		model.Parent = state.Model.Items
		setConveyorVelocity(model)
	end
end

local function hideAllItems(state)
	for id, model in pairs(state.ItemModels) do
		model.Parent = state.Storage
		state.Owned[id] = nil
	end
	state.Owned = {}
	state.Timers = {}
end

-- ---------- Compra ----------
local function tryBuy(state, player: Player, id: string)
	local item = Config.ById[id]
	if not item or state.Owner ~= player or state.Owned[id] then
		return
	end
	if item.Requires and not state.Owned[item.Requires] then
		return
	end
	local cash = getCash(player)
	if cash < item.Price then
		notify(player, "Faltam " .. Format(item.Price - cash) .. " para: " .. item.Name, "erro")
		return
	end
	setCash(player, cash - item.Price)
	ownItem(state, id)
	refreshButtons(state)
	notify(player, "✅ Comprado: " .. item.Name, "ok")
	if item.Type == "Trophy" then
		notify(player, "🏆 Você ganhou o Game of the Year! Agora pode fazer REBIRTH.", "ok")
	elseif item.Type == "Multiplier" then
		notify(player, "📈 Renda multiplicada por " .. tostring(item.Mult) .. "x!", "ok")
	elseif item.Type == "Expansion" then
		notify(player, "🏗️ Nova linha de produção liberada!", "ok")
	end
end

-- ---------- Produção (cartuchos) ----------
local function spawnDrop(state, head: BasePart, value: number)
	local drop = Instance.new("Part")
	drop.Name = "Cartucho"
	drop.Size = Vector3.new(1.2, 0.5, 1.6)
	drop.Color = head.Color
	drop.Material = Enum.Material.SmoothPlastic
	drop.TopSurface = Enum.SurfaceType.Smooth
	drop.BottomSurface = Enum.SurfaceType.Smooth
	drop.CFrame = CFrame.new(head.Position - Vector3.new(0, 2.2, 0)) * CFrame.Angles(0, math.rad(math.random(-20, 20)), 0)
	drop:SetAttribute("Value", value)
	drop:SetAttribute("Plot", state.Model.Name)

	local label = Instance.new("Part")
	label.Name = "Etiqueta"
	label.Size = Vector3.new(0.9, 0.1, 0.7)
	label.Color = Color3.new(1, 1, 1)
	label.Material = Enum.Material.SmoothPlastic
	label.CanCollide = false
	label.Massless = true
	label.CFrame = drop.CFrame * CFrame.new(0, 0.28, -0.2)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = drop
	weld.Part1 = label
	weld.Parent = drop
	label.Parent = drop

	drop.Parent = dropsFolder
	pcall(function()
		drop:SetNetworkOwner(nil)
	end)
	Debris:AddItem(drop, 30)
end

local function onCollectorTouched(state, collector: BasePart, hit: BasePart)
	if hit.Name ~= "Cartucho" or hit:GetAttribute("Plot") ~= state.Model.Name or hit:GetAttribute("Done") then
		return
	end
	hit:SetAttribute("Done", true)
	local value = hit:GetAttribute("Value") or 0
	hit:Destroy()
	if not state.Owner then
		return
	end
	local amount = math.floor(value * getMultiplier(state))
	if state.Owner:GetAttribute("AutoCollect") then
		addCash(state.Owner, amount)
	else
		state.Bank += amount
		updateBank(state)
	end
	-- efeito de brilho na publicadora
	local light = collector:FindFirstChildOfClass("PointLight")
	if light then
		light.Brightness = 4
		task.delay(0.15, function()
			light.Brightness = 1
		end)
	end
end

-- ---------- Assumir / liberar estúdio ----------
local function teleportToPlot(player: Player, state)
	local char = player.Character
	if char and state then
		char:PivotTo(state.Door.CFrame * CFrame.new(0, 0, 8) * CFrame.Angles(0, math.pi, 0))
	end
end

local function claim(state, player: Player)
	if state.Owner or playerPlot[player] then
		return
	end
	local data = playerData[player]
	if not data then
		return
	end
	state.Owner = player
	playerPlot[player] = state
	player:SetAttribute("PlotName", state.Model.Name)

	hideAllItems(state)
	for _, id in ipairs(Config.BASE_ITEMS) do
		ownItem(state, id)
	end
	for _, id in ipairs(data.Owned or {}) do
		if Config.ById[id] then
			ownItem(state, id)
		end
	end
	state.Bank = data.Bank or 0
	data.Bank = 0
	updateBank(state)
	updateDoor(state)
	refreshButtons(state)
	notify(player, "🎉 Bem-vindo ao seu estúdio de games!", "ok")
	notify(player, "Pise nos botões para contratar e melhorar. Colete o dinheiro no tapete verde.", "info")
end

local function release(state)
	if state.Owner then
		playerPlot[state.Owner] = nil
	end
	state.Owner = nil
	state.Bank = 0
	hideAllItems(state)
	clearDrops(state)
	updateBank(state)
	updateDoor(state)
	refreshButtons(state)
end

-- ---------- Montagem dos estúdios ----------
local function setupPlot(model: Model)
	local base = model:WaitForChild("Base")
	local state = {
		Model = model,
		Owner = nil,
		Owned = {},
		Bank = 0,
		Timers = {},
		Buttons = {},
		ItemModels = {},
		Storage = Instance.new("Folder"),
	}
	state.Storage.Name = "Armazem_" .. model.Name
	state.Storage.Parent = ServerStorage

	-- Porta
	state.Door = base:WaitForChild("Porta")
	local doorBB = makeBillboard(state.Door, 7, 320, 90, 120)
	state.DoorTitle = makeLabel(doorBB, "", Color3.new(1, 1, 1), 0.6, 0)
	state.DoorSub = makeLabel(doorBB, "", Color3.fromRGB(255, 230, 120), 0.4, 0.6, Enum.Font.GothamBold)
	state.Door.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player then
			claim(state, player)
		end
	end)

	-- Tapete de coleta
	local pad = base:WaitForChild("Coletar")
	local padBB = makeBillboard(pad, 4, 200, 80, 70)
	makeLabel(padBB, "💰 COLETAR", Color3.new(1, 1, 1), 0.45, 0)
	state.CollectLabel = makeLabel(padBB, "$0", Color3.fromRGB(120, 255, 140), 0.55, 0.45)
	local padDebounce = false
	pad.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player or player ~= state.Owner or padDebounce or state.Bank <= 0 then
			return
		end
		padDebounce = true
		local amount = state.Bank
		state.Bank = 0
		addCash(player, amount)
		updateBank(state)
		notify(player, "+" .. Format(amount), "ok")
		task.wait(0.5)
		padDebounce = false
	end)

	-- Publicadoras (coletores), esteiras, letreiros e nomes
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Name == "Publicadora" then
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(80, 160, 255)
				light.Range = 14
				light.Brightness = 1
				light.Parent = d
				local bb = makeBillboard(d, 6, 200, 50, 90)
				makeLabel(bb, "📦 PUBLICADORA", Color3.fromRGB(150, 210, 255), 1, 0)
				d.Touched:Connect(function(hit)
					onCollectorTouched(state, d, hit)
				end)
			elseif d.Name == "Letreiro" then
				local sg = Instance.new("SurfaceGui")
				sg.Face = Enum.NormalId.Front
				sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				sg.PixelsPerStud = 40
				sg.LightInfluence = 0
				sg.Parent = d
				state.SignLabel = makeLabel(sg, "ESTÚDIO", Color3.fromRGB(255, 255, 255), 1, 0)
			elseif d.Name == "Outdoor" then
				local sg = Instance.new("SurfaceGui")
				sg.Face = Enum.NormalId.Front
				sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				sg.PixelsPerStud = 30
				sg.LightInfluence = 0
				sg.Parent = d
				makeLabel(sg, "🎮 NOVO JOGO", Color3.fromRGB(255, 220, 60), 0.55, 0.05)
				makeLabel(sg, "JÁ DISPONÍVEL!", Color3.new(1, 1, 1), 0.35, 0.6)
			elseif d.Name == "Dropper" then
				local item = Config.ById[d.Parent.Name]
				if item then
					local bb = makeBillboard(d, 2.6, 180, 40, 55)
					makeLabel(bb, item.Name, Color3.new(1, 1, 1), 1, 0, Enum.Font.GothamBold)
				end
			elseif d.Name == "Copa" then
				local bb = makeBillboard(d, 3.5, 240, 50, 80)
				makeLabel(bb, "🏆 GAME OF THE YEAR", Color3.fromRGB(255, 215, 0), 1, 0)
			end
		end
	end
	setConveyorVelocity(model)

	-- Itens (guardados até serem comprados)
	for _, item in ipairs(model:WaitForChild("Items"):GetChildren()) do
		state.ItemModels[item.Name] = item
		item.Parent = state.Storage
	end

	-- Botões
	for _, btn in ipairs(model:WaitForChild("Buttons"):GetChildren()) do
		local item = Config.ById[btn.Name]
		if not item then
			warn("[Tycoon] Botão sem item na config:", btn.Name)
			continue
		end
		state.Buttons[btn.Name] = btn
		local bb = makeBillboard(btn, 3, 220, 70, 60)
		makeLabel(bb, item.Name, Color3.new(1, 1, 1), 0.55, 0)
		local priceLabel = makeLabel(bb, Format(item.Price), Color3.fromRGB(120, 255, 140), 0.45, 0.55)
		priceLabel.Name = "PriceLabel"
		btn.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player then
				tryBuy(state, player, btn.Name)
			end
		end)
		btn.Parent = state.Storage
	end

	updateBank(state)
	updateDoor(state)
	table.insert(plots, state)
end

for _, model in ipairs(workspace:WaitForChild("Tycoons"):GetChildren()) do
	if model:IsA("Model") then
		setupPlot(model)
	end
end

-- Loop de produção
RunService.Heartbeat:Connect(function(dt)
	for _, state in ipairs(plots) do
		if state.Owner then
			local interval = Config.DROP_INTERVAL * getSpeedFactor(state)
			for id in pairs(state.Owned) do
				local item = Config.ById[id]
				if item and item.Type == "Dropper" then
					local t = (state.Timers[id] or 0) + dt
					if t >= interval then
						t = 0
						local model = state.ItemModels[id]
						local head = model and model:FindFirstChild("Dropper")
						if head and model.Parent == state.Model.Items then
							spawnDrop(state, head, item.Value)
						end
					end
					state.Timers[id] = t
				end
			end
		end
	end
end)

-- ---------- Salvamento ----------
local function saveData(player: Player)
	local data = playerData[player]
	if not store or not data or not data.Loaded then
		return
	end
	local state = playerPlot[player]
	local owned = {}
	if state then
		for id in pairs(state.Owned) do
			table.insert(owned, id)
		end
	else
		owned = data.Owned or {}
	end
	local payload = {
		Cash = getCash(player),
		Rebirths = player:GetAttribute("Rebirths") or 0,
		Owned = owned,
		Bank = state and state.Bank or 0,
		LastDay = data.LastDay,
		Streak = data.Streak,
		LastSeen = os.time(),
		Rate = state and getIncomeRate(state) or data.Rate or 0,
	}
	local ok, err = pcall(function()
		store:SetAsync("p_" .. player.UserId, payload)
	end)
	if not ok then
		warn("[Tycoon] Erro ao salvar:", err)
	end
end

local function checkGamepasses(player: Player)
	local function owns(id: number): boolean
		if id == 0 then
			return false
		end
		local ok, result = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
		end)
		return ok and result == true
	end
	player:SetAttribute("Has2x", owns(Config.GAMEPASS_2X_ID))
	player:SetAttribute("AutoCollect", owns(Config.GAMEPASS_AUTOCOLLECT_ID))
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	if passId == Config.GAMEPASS_2X_ID then
		player:SetAttribute("Has2x", true)
		notify(player, "💸 Dinheiro em Dobro ativado!", "ok")
	elseif passId == Config.GAMEPASS_AUTOCOLLECT_ID then
		player:SetAttribute("AutoCollect", true)
		notify(player, "⚡ Coleta Automática ativada!", "ok")
		local state = playerPlot[player]
		if state and state.Bank > 0 then
			addCash(player, state.Bank)
			state.Bank = 0
			updateBank(state)
		end
	end
	local state = playerPlot[player]
	if state then
		refreshButtons(state)
	end
end)

-- ---------- Jogadores ----------
local function onPlayerAdded(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("NumberValue")
	cash.Name = "Dinheiro"
	cash.Parent = ls
	local reb = Instance.new("IntValue")
	reb.Name = "Rebirths"
	reb.Parent = ls

	local data = { Cash = Config.START_CASH, Rebirths = 0, Owned = {}, Bank = 0, Loaded = false }
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("p_" .. player.UserId)
		end)
		if ok then
			data.Loaded = true
			if type(result) == "table" then
				data.Cash = tonumber(result.Cash) or data.Cash
				data.Rebirths = tonumber(result.Rebirths) or 0
				data.Owned = type(result.Owned) == "table" and result.Owned or {}
				data.Bank = tonumber(result.Bank) or 0
				data.LastDay = tonumber(result.LastDay)
				data.Streak = tonumber(result.Streak) or 0
				data.LastSeen = tonumber(result.LastSeen)
				data.Rate = tonumber(result.Rate) or 0
			end
		else
			warn("[Tycoon] Erro ao carregar dados (não vamos salvar por cima):", result)
		end
	end
	playerData[player] = data

	cash.Value = data.Cash
	reb.Value = data.Rebirths
	player:SetAttribute("Rebirths", data.Rebirths)
	ls.Parent = player

	checkGamepasses(player)

	-- Lucro offline e recompensa diária (só com dados carregados, para não dar em dobro)
	if data.Loaded then
		local messages = {}
		if data.LastSeen and (data.Rate or 0) > 0 then
			local seconds = math.clamp(os.time() - data.LastSeen, 0, Config.OFFLINE_MAX_HOURS * 3600)
			local earned = math.floor(seconds * data.Rate * Config.OFFLINE_RATE)
			if seconds >= 60 and earned > 0 then
				cash.Value += earned
				table.insert(messages, { "🌙 Enquanto você estava fora, seu estúdio lucrou " .. Format(earned) .. "!", "ok" })
			end
		end
		local today = math.floor(os.time() / 86400)
		if data.LastDay ~= today then
			if data.LastDay == today - 1 then
				data.Streak = (data.Streak or 0) + 1
			else
				data.Streak = 1
			end
			data.LastDay = today
			local day = math.min(data.Streak, 7)
			local reward = Config.DAILY_BASE * day * (1 + data.Rebirths)
			cash.Value += reward
			table.insert(messages, { "🎁 Recompensa diária (dia " .. data.Streak .. "): +" .. Format(reward) .. "  •  Volte amanhã para ganhar mais!", "ok" })
		end
		player:SetAttribute("Streak", data.Streak or 0)
		if #messages > 0 then
			task.delay(5, function()
				for _, m in ipairs(messages) do
					if player.Parent then
						notify(player, m[1], m[2])
					end
				end
			end)
		end
	end

	cash.Changed:Connect(function()
		local state = playerPlot[player]
		if state then
			refreshButtons(state)
		end
	end)

	player.CharacterAdded:Connect(function()
		local state = playerPlot[player]
		if state then
			task.wait(0.2)
			teleportToPlot(player, state)
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	saveData(player)
	local state = playerPlot[player]
	if state then
		release(state)
	end
	playerData[player] = nil
	lastNotify[player] = nil
end)

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(saveData, player)
	end
	task.wait(3)
end)

-- Salvamento automático a cada 60s
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(saveData, player)
		end
	end
end)

-- ---------- Produtos de desenvolvedor (pacotes de dinheiro) ----------
local productsById = {}
for _, product in ipairs(Config.PRODUCTS) do
	if product.Id ~= 0 then
		productsById[product.Id] = product
	end
end
local processedReceipts = {}

MarketplaceService.ProcessReceipt = function(receipt)
	if processedReceipts[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local product = productsById[receipt.ProductId]
	if not player or not product or not player:FindFirstChild("leaderstats") then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local amount = product.Amount * (1 + (player:GetAttribute("Rebirths") or 0))
	addCash(player, amount)
	processedReceipts[receipt.PurchaseId] = true
	notify(player, "💰 " .. product.Name .. ": +" .. Format(amount), "ok")
	task.spawn(saveData, player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ---------- Rebirth ----------
rebirthFunc.OnServerInvoke = function(player)
	local state = playerPlot[player]
	if not state then
		return false, "Assuma um estúdio primeiro!"
	end
	if not state.Owned["trofeu"] then
		return false, "Compre o Troféu Game of the Year para fazer Rebirth!"
	end
	local rebirths = (player:GetAttribute("Rebirths") or 0) + 1
	player:SetAttribute("Rebirths", rebirths)
	local ls = player:FindFirstChild("leaderstats")
	if ls and ls:FindFirstChild("Rebirths") then
		ls.Rebirths.Value = rebirths
	end
	setCash(player, 0)
	hideAllItems(state)
	clearDrops(state)
	state.Bank = 0
	for _, id in ipairs(Config.BASE_ITEMS) do
		ownItem(state, id)
	end
	updateBank(state)
	refreshButtons(state)
	task.spawn(saveData, player)
	local bonus = math.floor(Config.REBIRTH_BONUS * rebirths * 100)
	return true, "🔄 Rebirth " .. rebirths .. "! Bônus permanente: +" .. bonus .. "% de renda"
end
]]></ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX908">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX909">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX910">
        <Properties>
          <string name="Name">TycoonClient</string>
          <ProtectedString name="Source"><![CDATA[-- ============================================================
--  ESTÚDIO DE GAMES TYCOON - Interface do jogador
-- ============================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("TycoonConfig"))
local Format = Config.Format
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyEvent = remotes:WaitForChild("Notify")
local rebirthFunc = remotes:WaitForChild("Rebirth")

local gui = Instance.new("ScreenGui")
gui.Name = "TycoonHUD"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent: Instance, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 12)
	c.Parent = parent
end

local function stroke(parent: Instance, color: Color3, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

local function label(parent: Instance, text: string, font: Enum.Font, color: Color3)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = font
	l.TextColor3 = color
	l.TextScaled = true
	l.Text = text
	l.Parent = parent
	return l
end

-- ---------- Painel de dinheiro ----------
local cashFrame = Instance.new("Frame")
cashFrame.AnchorPoint = Vector2.new(0.5, 0)
cashFrame.Position = UDim2.new(0.5, 0, 0, 8)
cashFrame.Size = UDim2.fromOffset(280, 70)
cashFrame.BackgroundColor3 = Color3.fromRGB(22, 24, 38)
cashFrame.BackgroundTransparency = 0.1
cashFrame.Parent = gui
corner(cashFrame, 16)
stroke(cashFrame, Color3.fromRGB(155, 89, 182), 3)

local cashLabel = label(cashFrame, "$0", Enum.Font.FredokaOne, Color3.fromRGB(110, 255, 140))
cashLabel.Size = UDim2.new(1, -20, 0.6, 0)
cashLabel.Position = UDim2.new(0, 10, 0, 4)

local infoLabel = label(cashFrame, "x1.0 • Rebirths: 0", Enum.Font.GothamBold, Color3.fromRGB(200, 200, 230))
infoLabel.Size = UDim2.new(1, -20, 0.3, 0)
infoLabel.Position = UDim2.new(0, 10, 0.62, 0)

-- ---------- Próxima meta ----------
local goalFrame = Instance.new("Frame")
goalFrame.AnchorPoint = Vector2.new(0.5, 0)
goalFrame.Position = UDim2.new(0.5, 0, 0, 84)
goalFrame.Size = UDim2.fromOffset(280, 44)
goalFrame.BackgroundColor3 = Color3.fromRGB(22, 24, 38)
goalFrame.BackgroundTransparency = 0.1
goalFrame.Visible = false
goalFrame.Parent = gui
corner(goalFrame, 12)

local goalLabel = label(goalFrame, "", Enum.Font.GothamBold, Color3.new(1, 1, 1))
goalLabel.Size = UDim2.new(1, -16, 0, 18)
goalLabel.Position = UDim2.fromOffset(8, 4)

local barBack = Instance.new("Frame")
barBack.Size = UDim2.new(1, -16, 0, 12)
barBack.Position = UDim2.fromOffset(8, 26)
barBack.BackgroundColor3 = Color3.fromRGB(50, 52, 70)
barBack.Parent = goalFrame
corner(barBack, 6)
local barFill = Instance.new("Frame")
barFill.Size = UDim2.fromScale(0, 1)
barFill.BackgroundColor3 = Color3.fromRGB(110, 255, 140)
barFill.Parent = barBack
corner(barFill, 6)

-- ---------- Notificações ----------
local toastHolder = Instance.new("Frame")
toastHolder.AnchorPoint = Vector2.new(0.5, 0)
toastHolder.Position = UDim2.new(0.5, 0, 0, 136)
toastHolder.Size = UDim2.fromOffset(380, 220)
toastHolder.BackgroundTransparency = 1
toastHolder.Parent = gui
local toastLayout = Instance.new("UIListLayout")
toastLayout.Padding = UDim.new(0, 6)
toastLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
toastLayout.SortOrder = Enum.SortOrder.LayoutOrder
toastLayout.Parent = toastHolder

local TOAST_COLORS = {
	ok = Color3.fromRGB(39, 174, 96),
	erro = Color3.fromRGB(192, 57, 43),
	info = Color3.fromRGB(41, 128, 185),
}
local toastCount = 0

local function toast(text: string, kind: string?)
	toastCount += 1
	local items = {}
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("TextLabel") then
			table.insert(items, c)
		end
	end
	if #items >= 4 then
		table.sort(items, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		items[1]:Destroy()
	end
	local t = Instance.new("TextLabel")
	t.LayoutOrder = toastCount
	t.Size = UDim2.new(1, 0, 0, 38)
	t.BackgroundColor3 = TOAST_COLORS[kind or "info"] or TOAST_COLORS.info
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Font = Enum.Font.GothamBold
	t.TextSize = 17
	t.TextWrapped = true
	t.Text = text
	t.Parent = toastHolder
	corner(t, 10)
	task.delay(3.2, function()
		if t.Parent then
			local tw = TweenService:Create(t, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
			tw:Play()
			tw.Completed:Wait()
			t:Destroy()
		end
	end)
end

notifyEvent.OnClientEvent:Connect(toast)

-- ---------- Botões laterais ----------
local side = Instance.new("Frame")
side.AnchorPoint = Vector2.new(0, 0.5)
side.Position = UDim2.new(0, 12, 0.5, 0)
side.Size = UDim2.fromOffset(200, 200)
side.BackgroundTransparency = 1
side.Parent = gui
local sideLayout = Instance.new("UIListLayout")
sideLayout.Padding = UDim.new(0, 8)
sideLayout.SortOrder = Enum.SortOrder.LayoutOrder
sideLayout.Parent = side

local function sideButton(text: string, color: Color3, order: number)
	local b = Instance.new("TextButton")
	b.LayoutOrder = order
	b.Size = UDim2.new(1, 0, 0, 50)
	b.BackgroundColor3 = color
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.FredokaOne
	b.TextSize = 22
	b.Text = text
	b.AutoButtonColor = true
	b.Parent = side
	corner(b, 12)
	stroke(b, Color3.fromRGB(20, 20, 30), 2)
	return b
end

local rebirthBtn = sideButton("🔄 Rebirth", Color3.fromRGB(110, 110, 130), 1)
local pass2xBtn = sideButton("💸 Dinheiro 2x", Color3.fromRGB(241, 196, 15), 2)
local passAutoBtn = sideButton("⚡ Coleta Auto", Color3.fromRGB(52, 152, 219), 3)

local confirmUntil = 0
rebirthBtn.MouseButton1Click:Connect(function()
	if not player:GetAttribute("CanRebirth") then
		toast("Compre o 🏆 Troféu Game of the Year para liberar o Rebirth!", "erro")
		return
	end
	if os.clock() > confirmUntil then
		confirmUntil = os.clock() + 4
		local bonus = math.floor(Config.REBIRTH_BONUS * 100)
		toast("Clique de novo para confirmar: você perde tudo e ganha +" .. bonus .. "% de renda para sempre", "info")
		return
	end
	confirmUntil = 0
	local ok, msg = rebirthFunc:InvokeServer()
	toast(msg or "", ok and "ok" or "erro")
end)

pass2xBtn.MouseButton1Click:Connect(function()
	if Config.GAMEPASS_2X_ID ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, Config.GAMEPASS_2X_ID)
	end
end)
passAutoBtn.MouseButton1Click:Connect(function()
	if Config.GAMEPASS_AUTOCOLLECT_ID ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, Config.GAMEPASS_AUTOCOLLECT_ID)
	end
end)

-- ---------- Loja de pacotes de dinheiro ----------
local activeProducts = {}
for _, product in ipairs(Config.PRODUCTS) do
	if product.Id ~= 0 then
		table.insert(activeProducts, product)
	end
end

local shopBtn = sideButton("🛒 Loja", Color3.fromRGB(39, 174, 96), 4)
shopBtn.Visible = #activeProducts > 0

local shop = Instance.new("Frame")
shop.AnchorPoint = Vector2.new(0.5, 0.5)
shop.Position = UDim2.fromScale(0.5, 0.5)
shop.Size = UDim2.fromOffset(340, 90 + #activeProducts * 64)
shop.BackgroundColor3 = Color3.fromRGB(22, 24, 38)
shop.Visible = false
shop.Parent = gui
corner(shop, 16)
stroke(shop, Color3.fromRGB(39, 174, 96), 3)

local shopTitle = label(shop, "🛒 Pacotes de Dinheiro", Enum.Font.FredokaOne, Color3.new(1, 1, 1))
shopTitle.Size = UDim2.new(1, -60, 0, 40)
shopTitle.Position = UDim2.fromOffset(14, 10)
shopTitle.TextXAlignment = Enum.TextXAlignment.Left

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.fromOffset(36, 36)
closeBtn.Position = UDim2.new(1, -46, 0, 12)
closeBtn.BackgroundColor3 = Color3.fromRGB(192, 57, 43)
closeBtn.TextColor3 = Color3.new(1, 1, 1)
closeBtn.Font = Enum.Font.FredokaOne
closeBtn.TextSize = 20
closeBtn.Text = "X"
closeBtn.Parent = shop
corner(closeBtn, 8)

for i, product in ipairs(activeProducts) do
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -28, 0, 54)
	b.Position = UDim2.fromOffset(14, 60 + (i - 1) * 64)
	b.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.FredokaOne
	b.TextSize = 20
	b.Parent = shop
	corner(b, 10)
	local function updateText()
		local amount = product.Amount * (1 + (player:GetAttribute("Rebirths") or 0))
		b.Text = "💰 " .. product.Name .. "  •  +" .. Format(amount)
	end
	updateText()
	player:GetAttributeChangedSignal("Rebirths"):Connect(updateText)
	b.MouseButton1Click:Connect(function()
		MarketplaceService:PromptProductPurchase(player, product.Id)
	end)
end

shopBtn.MouseButton1Click:Connect(function()
	shop.Visible = not shop.Visible
end)
closeBtn.MouseButton1Click:Connect(function()
	shop.Visible = false
end)

-- ---------- Dica inicial ----------
local hint = Instance.new("TextLabel")
hint.AnchorPoint = Vector2.new(0.5, 1)
hint.Position = UDim2.new(0.5, 0, 1, -24)
hint.Size = UDim2.fromOffset(520, 46)
hint.BackgroundColor3 = Color3.fromRGB(22, 24, 38)
hint.BackgroundTransparency = 0.15
hint.TextColor3 = Color3.fromRGB(255, 230, 120)
hint.Font = Enum.Font.GothamBold
hint.TextScaled = true
hint.Text = "🎮 Encontre um estúdio livre e toque na porta azul para ser o dono!"
hint.Parent = gui
corner(hint, 12)
local hintPad = Instance.new("UIPadding")
hintPad.PaddingLeft = UDim.new(0, 12)
hintPad.PaddingRight = UDim.new(0, 12)
hintPad.PaddingTop = UDim.new(0, 6)
hintPad.PaddingBottom = UDim.new(0, 6)
hintPad.Parent = hint

-- ---------- Atualização ----------
local ls = player:WaitForChild("leaderstats")
local cashValue = ls:WaitForChild("Dinheiro")

local function refresh()
	cashLabel.Text = Format(cashValue.Value)
	local mult = player:GetAttribute("Multiplier") or 1
	local reb = player:GetAttribute("Rebirths") or 0
	local rate = player:GetAttribute("IncomeRate") or 0
	infoLabel.Text = string.format("%s/s  •  x%.1f  •  Rebirths: %d", Format(rate), mult, reb)
	local goal = player:GetAttribute("NextGoal") or ""
	local price = player:GetAttribute("NextPrice") or 0
	goalFrame.Visible = goal ~= "" and player:GetAttribute("PlotName") ~= nil
	if goalFrame.Visible then
		local ratio = price > 0 and math.clamp(cashValue.Value / price, 0, 1) or 1
		goalLabel.Text = (ratio >= 1 and "✅ Pode comprar: " or "🎯 Próxima meta: ") .. goal .. " (" .. Format(price) .. ")"
		TweenService:Create(barFill, TweenInfo.new(0.2), { Size = UDim2.fromScale(ratio, 1) }):Play()
		barFill.BackgroundColor3 = ratio >= 1 and Color3.fromRGB(255, 210, 63) or Color3.fromRGB(110, 255, 140)
	end
	rebirthBtn.BackgroundColor3 = player:GetAttribute("CanRebirth") and Color3.fromRGB(155, 89, 182)
		or Color3.fromRGB(110, 110, 130)
	pass2xBtn.Visible = Config.GAMEPASS_2X_ID ~= 0 and not player:GetAttribute("Has2x")
	passAutoBtn.Visible = Config.GAMEPASS_AUTOCOLLECT_ID ~= 0 and not player:GetAttribute("AutoCollect")
	hint.Visible = player:GetAttribute("PlotName") == nil
end

local lastCash = cashValue.Value
cashValue.Changed:Connect(function(v)
	if v > lastCash then
		local up = TweenService:Create(cashLabel, TweenInfo.new(0.08), { TextColor3 = Color3.fromRGB(255, 255, 140) })
		up:Play()
		up.Completed:Connect(function()
			TweenService:Create(cashLabel, TweenInfo.new(0.25), { TextColor3 = Color3.fromRGB(110, 255, 140) }):Play()
		end)
	end
	lastCash = v
	refresh()
end)
player.AttributeChanged:Connect(refresh)
refresh()
]]></ProtectedString>
