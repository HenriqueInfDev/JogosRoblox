local skinButtons = {}
for i, skin in ipairs(Config.SKINS) do
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -28, 0, 44)
	b.Position = UDim2.fromOffset(14, 54 + (i - 1) * 52)
